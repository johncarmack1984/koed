NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info

DATABASE_URL=postgres://codex_memory:codex_memory@localhost:15432/codex_memory
REDIS_URL=redis://redis:6379
DATA_ENCRYPTION_KEY=base64_replace_with_32_bytes_for_provider_key_encryption
API_TOKEN_PEPPER=replace_with_random_server_side_token_pepper
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_BODY_LIMIT_BYTES=262144
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
MEMORY_RATE_LIMIT_WINDOW_MS=60000
MEMORY_RATE_LIMIT_MAX=120
MEMORY_MODE=codex_subscription
# Only set with MEMORY_MODE=server_synthesis for approved dev/test backend LLM calls.
# MEMORY_SERVER_SYNTHESIS_UNSAFE_ALLOW=1
EMBEDDING_SERVICE_URL=http://embedding-service:8000
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBEDDING_DIMENSIONS=1024
EMBEDDING_VERSION=local-qwen3-embedding-0.6b-gguf-v1
RERANKING_ENABLED=false
MEMORY_VECTOR_CANDIDATE_LIMIT=20
RERANKER_ENABLED=false
RERANKER_MODEL=n24q02m/Qwen3-Reranker-0.6B-ONNX
RERANKER_BATCH_LIMIT=100
EMBEDDING_MAX_TOKENS=32768
LLAMA_N_CTX=32768
MEMORY_LCM_LEAF_EVENT_THRESHOLD=5
MEMORY_LCM_LEAF_TOKEN_THRESHOLD=6000
MEMORY_LCM_FRESH_EVENT_TAIL=1
MEMORY_LCM_DEPTH1_FANOUT=2
# LCM summarization runs locally in the MCP process through the user's Codex
# subscription. Backend workers only create pending summary nodes.
MEMORY_LCM_SUMMARY_PROVIDER=codex
# MEMORY_LCM_SUMMARY_MODEL=gpt-5.4-mini
# Token estimates for LCM compaction and summaries use the tokenizer mapped to
# MEMORY_LCM_SUMMARY_MODEL.
# MEMORY_LCM_SUMMARY_REASONING_EFFORT=high
# MEMORY_LCM_SUMMARY_TIMEOUT_MS=120000
# MEMORY_LCM_SUMMARY_MAX_ATTEMPTS=3
# MEMORY_LCM_SUMMARY_MAX_PROMPT_TOKENS=32000
# MEMORY_LCM_CODEX_BINARY=codex
MEMORY_LCM_BACKGROUND_ENABLED=true
MEMORY_LCM_BACKGROUND_INITIAL_DELAY_MS=30000
MEMORY_LCM_BACKGROUND_PUSH_DELAY_MS=10000
MEMORY_LCM_BACKGROUND_INTERVAL_MS=1800000
MEMORY_LCM_BACKGROUND_BATCH_LIMIT=2
CODEX_MEMORY_HOOK_TRIGGER_LCM_SUMMARY=true
CODEX_MEMORY_HOOK_LCM_SUMMARY_DELAY_MS=10000
CODEX_MEMORY_HOOK_LCM_SUMMARY_LIMIT=2
# Local MCP memory_answer synthesis. The backend still returns evidence only in
# codex_subscription mode; this worker uses the user's local Codex CLI account.
MEMORY_ANSWER_PROVIDER=codex
# Set MEMORY_ANSWER_PROVIDER=evidence to return evidence for the main agent to
# synthesize instead of running the local hidden memory-answer worker.
# MEMORY_ANSWER_MODEL=gpt-5.4-mini
# Local memory-answer prompt token estimates use the tokenizer mapped to
# MEMORY_ANSWER_MODEL.
# MEMORY_ANSWER_REASONING_EFFORT=high
# MEMORY_ANSWER_TIMEOUT_MS=120000
# MEMORY_ANSWER_MAX_ATTEMPTS=2
# MEMORY_ANSWER_CODEX_BINARY=codex

CODEX_MEMORY_BASE_URL=http://localhost:3000
CODEX_MEMORY_API_TOKEN=replace_with_console_created_token
